# SentinelPlan Frontend — Environment Variables
#
# Copy this file to .env.local for local development
# On Vercel: set these in Project Settings → Environment Variables
#
# ─── REQUIRED FOR PRODUCTION (Vercel) ──────────────────────────────────────
# The URL of the deployed FastAPI backend (no trailing slash!)
VITE_API_URL=https://coderush2-0-innoventures.onrender.com/api
#
# ─── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────
# Leave VITE_API_URL unset (or comment it out) when running on localhost.
# Vite's dev proxy (vite.config.js) will forward /api/* → http://127.0.0.1:8000
