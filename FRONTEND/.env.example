# SentinelPlan Frontend — Environment Variables
#
# Copy this file to .env.local for local development.
# On Vercel: set these in Project → Settings → Environment Variables.
#
# ─── REQUIRED FOR PRODUCTION (Vercel) ──────────────────────────────────────
#
# Backend base origin — NO trailing slash, NO /api suffix.
# The code appends /api/... to every endpoint automatically.
#
VITE_API_URL=https://coderush2-0-innoventures.onrender.com
#
# ─── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────
#
# Leave VITE_API_URL unset (comment it out) on localhost.
# Vite's dev proxy (vite.config.js) transparently forwards:
#   /api/* → http://127.0.0.1:8000
#
# So all fetch(`${API_URL}/api/...`) calls resolve correctly in both envs.
